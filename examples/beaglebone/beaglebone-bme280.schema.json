{
  "name":        "beaglebone-bme280",
  "version":     "1.0",
  "description": "BeagleBone Black — BME280 Sensor (temperature, humidity, pressure) + GPIO USR0 LED",
  "properties": {
    "temperature": {
      "type":     "float",
      "unit":     "°C",
      "readable": true,
      "writable": false
    },
    "humidity": {
      "type":     "float",
      "unit":     "%rH",
      "readable": true,
      "writable": false
    },
    "pressure": {
      "type":     "float",
      "unit":     "hPa",
      "readable": true,
      "writable": false
    },
    "gpio_usr0": {
      "type":        "int",
      "description": "USR0 LED (GPIO 60) — 0=off, 1=on",
      "readable":    true,
      "writable":    true
    }
  }
}
