{
  "udal": "1.0",
  "kind": "DeviceCapability",
  "metadata": {
    "name": "beaglebone-bme280",
    "version": "1.0.0",
    "description": "BeagleBone Black — BME280 Sensor (temperature, humidity, pressure) + GPIO USR0 LED",
    "tags": ["sensor", "gpio", "beaglebone"]
  },
  "properties": {
    "temperature": {
      "type":     "float",
      "unit":     "°C",
      "readOnly": true
    },
    "humidity": {
      "type":     "float",
      "unit":     "%rH",
      "readOnly": true
    },
    "pressure": {
      "type":     "float",
      "unit":     "hPa",
      "readOnly": true
    },
    "gpio_usr0": {
      "type":        "int",
      "description": "USR0 LED (GPIO 60) — 0=off, 1=on",
      "min":         0,
      "max":         1
    }
  }
}
